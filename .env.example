# Vorlage — echte Werte gehoeren in .env (untracked, chmod 600).
# Ohne GOOGLE_CLIENT_ID laeuft die App im LESEMODUS:
# kein Hinzufuegen, kein Loeschen, keine persoenlichen Favoriten.
#
# OAuth-Client anlegen: https://console.cloud.google.com/apis/credentials
#   -> OAuth-Client-ID -> Webanwendung
#   -> Autorisierter Redirect-URI: https://<deine-domain>/oauth2callback
#   -> Zustimmungsbildschirm auf "Veroeffentlicht" setzen, sonst kommen nur
#      eingetragene Testnutzer rein (keine Google-Pruefung noetig, da nur
#      Name + Mailadresse abgefragt werden).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signiert das Anmelde-Cookie. Erzeugen mit:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_COOKIE_SECRET=
AUTH_REDIRECT_URI=https://research.georgshost.eu/oauth2callback

# Diese Adresse darf Aktien loeschen (alle anderen nur hinzufuegen).
ADMIN_EMAIL=
